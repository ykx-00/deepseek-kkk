import streamlit as st
import requests

st.set_page_config(page_title="DeepSeek API 演示", page_icon="🤖")
st.title("🤖 DeepSeek API 智能对话演示")
st.markdown("输入你的 API Key 和问题，即可与大模型对话")

# 输入 API Key（保密，不会记录）
api_key = st.text_input("🔑 DeepSeek API Key", type="password", help="去 platform.deepseek.com 免费获取")

# 用户输入
user_input = st.text_area("💬 你的问题", height=100)

# 对话历史（简单版）
if "messages" not in st.session_state:
    st.session_state.messages = []

# 显示历史消息
for msg in st.session_state.messages:
    with st.chat_message(msg["role"]):
        st.write(msg["content"])

# 发送按钮
if st.button("发送提问") and api_key and user_input:
    # 显示用户消息
    st.session_state.messages.append({"role": "user", "content": user_input})
    with st.chat_message("user"):
        st.write(user_input)

    # 调用 DeepSeek API
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    data = {
        "model": "deepseek-chat",
        "messages": st.session_state.messages,
        "stream": False
    }
    
    with st.spinner("DeepSeek 思考中..."):
        try:
            response = requests.post(
                "https://api.deepseek.com/v1/chat/completions",
                headers=headers,
                json=data,
                timeout=30
            )
            if response.status_code == 200:
                reply = response.json()["choices"][0]["message"]["content"]
                st.session_state.messages.append({"role": "assistant", "content": reply})
                with st.chat_message("assistant"):
                    st.write(reply)
            else:
                st.error(f"API 错误：{response.status_code} - {response.text}")
        except Exception as e:
            st.error(f"请求失败：{e}")

st.markdown("---")
st.caption("提示：API Key 仅用于本次演示，不会被保存。Demo 仅作功能展示。")
